<section class="password" data-section-id="{{ section.id }}">
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="password__stage">
    {%- render 'wordmark', modifier: 'password' -%}
  </div>
  <div class="wrap password__inner">
    <p class="tag">{{ section.settings.tag | escape }}</p>
    <h1 class="h-cond">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lede">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- if section.settings.show_newsletter -%}
      {%- render 'newsletter-form', form_id: section.id -%}
    {%- endif -%}

    <div class="password__login">
      <p class="field__label">{{ 'password.enter_store' | t }}</p>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="visually-hidden" for="password-{{ section.id }}">{{ 'password.password' | t }}</label>
        <div class="newsletter__row">
          <input class="input" type="password" name="password" id="password-{{ section.id }}" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--ghost btn--sm"><span>{{ 'password.enter' | t }}</span></button>
        </div>
      {%- endform -%}
      <p class="note">{{ 'password.owner_html' | t: link: '/admin' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Small label",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tear it. Squeeze it. Soon."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    }
  ]
}
{% endschema %}
