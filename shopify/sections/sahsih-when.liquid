<section
  class="when"
  id="when"
  data-section="when"
  data-section-id="{{ section.id }}"
  aria-labelledby="when-title-{{ section.id }}"
  style="--steps: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="when__stage">
    <div class="when__head" data-reveal>
      {%- if section.settings.tag != blank -%}
        <p class="tag" data-reveal-item>{{ section.settings.tag | escape }}</p>
      {%- endif -%}
      <h2 class="h-cond" id="when-title-{{ section.id }}" data-reveal-item>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="timeline">
      <div class="timeline__rail" aria-hidden="true"><div class="timeline__fill"></div></div>
      <div class="slot slot--when" data-slot="when" data-tilt="0" data-spin="1.8" data-glow="0.6"></div>
      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step{% if forloop.first %} is-on{% endif %}" data-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="step__node" aria-hidden="true"></span>
            {%- if block.settings.when != blank -%}
              <p class="step__when">{{ block.settings.when | escape }}</p>
            {%- endif -%}
            <h3 class="step__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="step__body rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sahsih when to take",
  "tag": "div",
  "class": "section-sahsih-when",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A timeline the jelly stick travels along as you scroll. Use two to four steps."
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Small label",
      "default": "04 / When to take"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pocket-sized. Timing is up to you."
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "Small label",
          "default": "Before"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "On the go"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>One stick on the way out. It fits in the pocket that isn't holding your phone.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sahsih when to take",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "when": "Before",
            "title": "On the go",
            "text": "<p>One stick on the way out. It fits in the pocket that isn't holding your phone.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "when": "During",
            "title": "Between rounds",
            "text": "<p>Somewhere between the second round and the taxi. No water, no glass, no ceremony.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "when": "After",
            "title": "The morning after",
            "text": "<p>Bedside, or the morning after, whichever version of you gets there first.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
