<section class="text-section text-section--{{ section.settings.alignment }}" data-section-id="{{ section.id }}">
  <div class="wrap text-section__inner" data-reveal>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'tag' -%}
          <p class="tag" data-reveal-item {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="h-cond text-section__heading" data-reveal-item {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="lede rte" data-reveal-item {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <div class="actions" data-reveal-item {{ block.shopify_attributes }}>
              <a class="btn {% if block.settings.style == 'ghost' %}btn--ghost{% else %}btn--skew{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}"><span>{{ block.settings.label | escape }}</span></a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "tag": "div",
  "class": "section-rich-text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Small label",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Good to know" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tear it. Squeeze it. Carry on." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "solid",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "ghost", "label": "Outline" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text",
      "blocks": [
        { "type": "tag" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
