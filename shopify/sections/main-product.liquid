{%- liquid
  assign current = product.selected_or_first_available_variant
  assign show_3d = false
  if settings.enable_3d and section.settings.show_3d
    assign show_3d = true
  endif
  assign active_media = current.featured_media | default: product.featured_media
  assign bundle = section.settings.bundle
  assign item_count = product.media.size
  if show_3d
    assign item_count = item_count | plus: 1
  endif
-%}
<section class="product" data-section="product" data-section-id="{{ section.id }}" data-product-section>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="wrap product__grid">
    <div class="product__media">
      <div class="gallery" data-gallery>
        <div class="gallery__stage">
          {%- if show_3d -%}
            <div class="gallery__item gallery__item--3d is-active" data-gallery-item="3d">
              <div class="slot slot--product" data-slot="product" data-tilt="-0.08" data-glow="0.72">
                {%- render 'slot-poster' -%}
              </div>
            </div>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if show_3d == false
                if active_media and media.id == active_media.id
                  assign is_active = true
                elsif active_media == blank and forloop.first
                  assign is_active = true
                endif
              endif
              if is_active or forloop.first
                assign loading = 'eager'
              else
                assign loading = 'lazy'
              endif
            -%}
            <div
              class="gallery__item{% if is_active %} is-active{% endif %}"
              data-gallery-item="{{ media.id }}"
              {% unless is_active %}
                hidden
              {% endunless %}
            >
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1400x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: loading,
                      widths: '400, 700, 1000, 1400',
                      sizes: '(min-width: 900px) 46vw, 100vw',
                      alt: media.alt,
                      class: 'gallery__img'
                  }}
              {%- endcase -%}
            </div>
          {%- else -%}
            {%- unless show_3d -%}
              <div class="gallery__item is-active" data-gallery-item="placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- if item_count > 1 -%}
          <div class="gallery__thumbs">
            {%- if show_3d -%}
              <button type="button" class="gallery__thumb gallery__thumb--3d" data-gallery-thumb="3d" aria-pressed="true">
                {%- render 'icon', name: 'cube' -%}
                <span>{{ 'products.view_3d' | t }}</span>
              </button>
            {%- endif -%}
            {%- for media in product.media -%}
              {%- liquid
                assign pressed = false
                if show_3d == false
                  if active_media and media.id == active_media.id
                    assign pressed = true
                  elsif active_media == blank and forloop.first
                    assign pressed = true
                  endif
                endif
              -%}
              <button
                type="button"
                class="gallery__thumb"
                data-gallery-thumb="{{ media.id }}"
                aria-pressed="{{ pressed }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 160', sizes: '72px' }}
                <span class="visually-hidden">{{ 'products.view_media' | t: number: forloop.index }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="product__info buy" data-reveal>
      {%- if section.settings.show_type and product.type != blank -%}
        <p class="tag" data-reveal-item>{{ product.type | escape }}</p>
      {%- endif -%}
      <h1 class="h-cond product__title" data-reveal-item>{{ product.title | escape }}</h1>
      {%- if section.settings.description_position == 'top' and product.description != blank -%}
        <div class="lede rte product__description" data-reveal-item>{{ product.description }}</div>
      {%- endif -%}

      {%- render 'buy-form',
        product: product,
        bundle: bundle,
        bundle_detail: section.settings.bundle_detail,
        form_key: section.id,
        sticks_per_box: section.settings.sticks_per_box,
        show_quantity: section.settings.show_quantity,
        show_dynamic_checkout: section.settings.show_dynamic_checkout,
        update_url: true,
        note: section.settings.note
      -%}

      {%- if section.settings.description_position == 'tab' and product.description != blank -%}
        <details class="disclosure" data-reveal-item>
          <summary class="disclosure__summary">
            <span>{{ 'products.description' | t }}</span>
            <span class="disclosure__icon" aria-hidden="true"></span>
          </summary>
          <div class="disclosure__body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="product__app">{% render block %}</div>
          {%- when 'collapsible' -%}
            <details class="disclosure" data-reveal-item {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary class="disclosure__summary">
                <span>{{ block.settings.heading | escape }}</span>
                <span class="disclosure__icon" aria-hidden="true"></span>
              </summary>
              <div class="disclosure__body rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>
          {%- when 'text' -%}
            <div class="note rte" data-reveal-item {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_3d",
      "label": "Show the 3D jelly stick first",
      "default": true,
      "info": "Product photos follow as thumbnails. Needs the 3D stick turned on in Theme settings."
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product type above the title",
      "default": true
    },
    {
      "type": "select",
      "id": "description_position",
      "label": "Product description",
      "default": "top",
      "options": [
        { "value": "top", "label": "Under the title" },
        { "value": "tab", "label": "In a tab under the button" },
        { "value": "hidden", "label": "Hidden" }
      ]
    },
    {
      "type": "number",
      "id": "sticks_per_box",
      "label": "Sticks per box",
      "default": 10,
      "info": "Used for the \"30 sticks\" line under each pack. Set to 0 to hide it."
    },
    {
      "type": "product",
      "id": "bundle",
      "label": "Bundle product",
      "info": "Optional. Shown as the last pack card, for example a mixed set."
    },
    {
      "type": "text",
      "id": "bundle_detail",
      "label": "Bundle card detail",
      "default": "50 sticks, all five flavours"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show express checkout buttons",
      "default": true,
      "info": "Shop Pay, Apple Pay and others, from Settings > Payments."
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note under the button"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "collapsible",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ingredients"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Milk thistle, electrolytes and B vitamins (B1, B6, B12). Full ingredient panel and allergen statement to be confirmed before launch.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from a page",
          "info": "Optional. Shown under the content above."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Dietary supplement. Not intended to diagnose, treat, cure or prevent any disease.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
