<section class="listing" data-section-id="{{ section.id }}">
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="wrap">
    <header class="page-head" data-reveal>
      <p class="tag" data-reveal-item>{{ 'collections.label' | t }}</p>
      <h1 class="h-cond" data-reveal-item>{{ section.settings.heading | escape }}</h1>
    </header>
    <ul class="cards cards--collections" data-reveal>
      {%- for collection in collections -%}
        {%- if collection.all_products_count == 0 -%}
          {%- continue -%}
        {%- endif -%}
        <li class="card" data-reveal-item>
          <a class="card__link" href="{{ collection.url }}">
            <span class="card__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 900px) 30vw, 50vw', alt: collection.title, class: 'card__img'
                }}
              {%- elsif collection.products.first.featured_media -%}
                {{
                  collection.products.first.featured_media.preview_image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 900px) 30vw, 50vw', alt: collection.title, class: 'card__img'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="card__body">
              <span class="card__title">{{ collection.title | escape }}</span>
              <span class="card__price">{{ 'collections.count' | t: count: collection.all_products_count }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
