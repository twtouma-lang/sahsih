<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <meta name="color-scheme" content="dark">

    {%- render 'meta-tags' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'sahsih-favicon.png' | asset_url }}">
    {%- endif -%}

    {{ 'archivo-var-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'sahsih.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-styles' -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    {%- render 'logo-sprite' -%}
    {%- if settings.film_grain -%}
      <div class="grain" aria-hidden="true"></div>
    {%- endif -%}
    <main id="main" class="main main--password">
      {{ content_for_layout }}
    </main>
  </body>
</html>
