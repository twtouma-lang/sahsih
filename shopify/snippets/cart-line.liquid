{%- comment -%}
  One line of the cart, for the drawer and the cart page.
  Accepts: item (line item), context ('drawer' or 'page')
  Usage: {% render 'cart-line', item: item, context: 'page' %}
{%- endcomment -%}
{%- liquid
  assign dot = ''
  for option in item.options_with_values
    capture c
      render 'flavour-color', value: option.value
    endcapture
    assign c = c | strip
    if c != blank
      assign dot = c
      break
    endif
  endfor
  assign title = item.product.title | escape
-%}
<li class="cart-item"{% if dot != blank %} style="--dot: {{ dot }};"{% endif %} data-cart-item>
  <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy', class: 'cart-item__img', widths: '100, 200' }}
    {%- else -%}
      <span class="cart-item__dot"></span>
    {%- endif -%}
  </a>

  <div class="cart-item__info">
    <a class="cart-item__name" href="{{ item.url }}">{{ title }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <span class="cart-item__variant">{{ item.variant.title | escape }}</span>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <span class="cart-item__variant">{{ property.first | escape }}: {{ property.last | escape }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if item.selling_plan_allocation -%}
      <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>
    {%- endif -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <span class="cart-item__discount">{{ discount.discount_application.title | escape }} (&minus;{{ discount.amount | money }})</span>
    {%- endfor -%}
    {%- assign each_price = item.final_price | money -%}
    <span class="cart-item__each">{{ 'cart.each' | t: price: each_price }}</span>
  </div>

  <span class="cart-item__total">
    {%- if item.original_line_price != item.final_line_price -%}
      <s>{{ item.original_line_price | money }}</s>
    {%- endif -%}
    {{ item.final_line_price | money }}
  </span>

  <div class="stepper" role="group" aria-label="{{ 'cart.quantity_of' | t: title: title }}">
    <button
      type="button"
      class="js-only"
      data-cart-qty="{{ item.quantity | minus: 1 }}"
      data-key="{{ item.key }}"
      aria-label="{{ 'cart.decrease' | t: title: title }}"
    >
      &minus;
    </button>
    {%- if context == 'page' -%}
      <input
        class="stepper__input"
        type="number"
        name="updates[]"
        value="{{ item.quantity }}"
        min="0"
        inputmode="numeric"
        aria-label="{{ 'cart.quantity_of' | t: title: title }}"
        data-cart-input
        data-key="{{ item.key }}"
      >
    {%- else -%}
      <output aria-live="polite">{{ item.quantity }}</output>
    {%- endif -%}
    <button
      type="button"
      class="js-only"
      data-cart-qty="{{ item.quantity | plus: 1 }}"
      data-key="{{ item.key }}"
      aria-label="{{ 'cart.increase' | t: title: title }}"
    >
      +
    </button>
  </div>

  <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-cart-qty="0" data-key="{{ item.key }}">
    {{- 'cart.remove' | t -}}
    <span class="visually-hidden"> {{ title }}</span>
  </a>
</li>
